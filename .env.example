# Toppkart — environment variables
#
# Copy to .env.local and fill in what you have. Every variable here is optional:
# with none of them set the app runs in demo mode (cookie-backed auth and
# subscription, see README). Each integration checks its own keys, so a partly
# filled file is fine — Supabase without Stripe gives you real auth and a demo
# subscription.
#
# Variables prefixed NEXT_PUBLIC_ are inlined into the JavaScript bundle at
# build time and are visible to anyone using the site. Never put a secret in one.
# Everything without that prefix stays server-side; keep it out of the browser,
# out of git and out of client components.


# --- Supabase ---------------------------------------------------------------
# Supabase dashboard → Project Settings → API.
# Required together for live auth and database; if either is missing the app
# falls back to demo auth (isSupabaseConfigured is false).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co.
# BROWSER-VISIBLE. Optional (demo mode without it).
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Safe to expose — it is bounded by row-level security.
# BROWSER-VISIBLE. Optional (demo mode without it).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Bypasses row-level security entirely: server-side only,
# never in a NEXT_PUBLIC_ variable, never logged. Same page in the dashboard.
# Optional — only needed for server work that must ignore RLS (e.g. the Stripe
# webhook writing a subscription row for a user it is not authenticated as).
SUPABASE_SERVICE_ROLE_KEY=


# --- Stripe -----------------------------------------------------------------
# Stripe dashboard. Use test-mode keys (sk_test_…) for anything that is not
# production. STRIPE_SECRET_KEY alone decides live vs demo billing
# (isStripeConfigured); without it checkout and the portal run in demo mode.

# Secret API key: Developers → API keys → Secret key. Server-side only.
# Optional (demo billing without it).
STRIPE_SECRET_KEY=

# Webhook signing secret (whsec_…): Developers → Webhooks → your endpoint →
# Signing secret. Locally, `stripe listen` prints one when it starts.
# Required whenever STRIPE_SECRET_KEY is set — unverified webhooks are rejected.
STRIPE_WEBHOOK_SECRET=

# Price ID (price_…) for the 29 kr/mnd recurring price: Product catalogue →
# your product → the monthly price. Required in live billing mode.
STRIPE_PRICE_MONTHLY=

# Price ID (price_…) for the 290 kr/år recurring price, same product.
# Required in live billing mode if the yearly plan is offered.
STRIPE_PRICE_YEARLY=


# --- Admin ------------------------------------------------------------------
# Who may open /admin/tilbakemeldinger, which lists what people wrote in the
# feedback dialog — including their e-mail addresses. Server-side only; never
# give this a NEXT_PUBLIC_ prefix.

# Comma-separated addresses, matched against the address on the Google account
# the visitor signed in with (case-insensitive). Example:
#   ADMIN_EMAILS=deg@example.com,noen.andre@example.com
#
# Optional, and it FAILS CLOSED: unset means nobody is an admin, not everybody.
# The page then answers 404 for every visitor, including you — which is the
# right way round for a page that shows other people's e-mail addresses.
ADMIN_EMAILS=


# --- Resend -----------------------------------------------------------------
# resend.com → API Keys. Transactional mail (receipts, trial-ending notices)
# sent after a Stripe checkout. Nothing to do with signing in — that is Google,
# and it sends no mail, so no SMTP is needed anywhere.

# API key (re_…). Server-side only. Optional — without it the app skips
# outbound mail instead of failing.
RESEND_API_KEY=

# Sender for transactional mail. The domain must be verified in Resend.
# Optional; defaults to "Toppkart <ingen-svar@toppkart.no>".
RESEND_FROM_EMAIL=


# --- Site -------------------------------------------------------------------

# Canonical origin, no trailing slash. Used to build Stripe Checkout return
# URLs and the links inside those mails, so it must match the URL people
# actually visit. BROWSER-VISIBLE. Optional: falls back to https://$VERCEL_URL
# on Vercel, then to http://localhost:3000.
# Local: http://localhost:3000   Production: https://toppkart.no
NEXT_PUBLIC_SITE_URL=

# VERCEL_URL is set automatically by Vercel on every deployment. Do not define
# it yourself. It only covers the per-deployment hostname, so set
# NEXT_PUBLIC_SITE_URL explicitly in production for a stable canonical origin.
