# Toppkart — environment variables
#
# Copy to .env.local and fill in what you have. Every variable here is optional:
# with none of them set the app runs in demo mode (cookie-backed admin sign-in,
# see README). Toppkart is free and has no reader accounts — Supabase only backs
# the admin sign-in and the feedback table.
#
# Variables prefixed NEXT_PUBLIC_ are inlined into the JavaScript bundle at
# build time and are visible to anyone using the site. Never put a secret in one.
# Everything without that prefix stays server-side; keep it out of the browser,
# out of git and out of client components.


# --- Supabase ---------------------------------------------------------------
# Supabase dashboard → Project Settings → API.
# Required together for live admin sign-in and the database; if either is
# missing the app falls back to demo auth (isSupabaseConfigured is false).

# Project URL, e.g. https://abcdefghijklmnop.supabase.co.
# BROWSER-VISIBLE. Optional (demo mode without it).
NEXT_PUBLIC_SUPABASE_URL=

# Anon / publishable key. Safe to expose — it is bounded by row-level security.
# BROWSER-VISIBLE. Optional (demo mode without it).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key. Bypasses row-level security entirely: server-side only,
# never in a NEXT_PUBLIC_ variable, never logged. Same page in the dashboard.
# Optional — only needed for server work that must ignore RLS (storing feedback
# from readers who are not signed in, and the rate limit beside it).
SUPABASE_SERVICE_ROLE_KEY=


# --- Admin ------------------------------------------------------------------
# Who may open /admin/tilbakemeldinger, which lists what people wrote in the
# feedback dialog — including their e-mail addresses. Server-side only; never
# give this a NEXT_PUBLIC_ prefix.

# Comma-separated addresses, matched against the address on the Google account
# the visitor signed in with (case-insensitive). Example:
#   ADMIN_EMAILS=deg@example.com,noen.andre@example.com
#
# Optional, and it FAILS CLOSED: unset means nobody is an admin, not everybody.
# The page then answers 404 for every visitor, including you — which is the
# right way round for a page that shows other people's e-mail addresses.
#
ADMIN_EMAILS=


# --- Site -------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for canonical URLs and the sign-in
# return address, so it must match the URL people actually visit. BROWSER-VISIBLE. Optional: falls back to https://$VERCEL_URL
# on Vercel, then to http://localhost:3000.
# Local: http://localhost:3000   Production: https://toppkart.no
NEXT_PUBLIC_SITE_URL=

# VERCEL_URL is set automatically by Vercel on every deployment. Do not define
# it yourself. It only covers the per-deployment hostname, so set
# NEXT_PUBLIC_SITE_URL explicitly in production for a stable canonical origin.
